# Copie ce fichier en .env (dans film-agent/) puis remplis les valeurs.
# Le fichier .env est ignoré par git : il ne quittera jamais ta machine.

ANTHROPIC_API_KEY=
PINECONE_API_KEY=
# Clé « API Key » v3 de TMDB (ou le « Read Access Token » v4, les deux marchent)
TMDB_API_KEY=

# Modèle Claude utilisé par l'agent
CLAUDE_MODEL=claude-sonnet-5-5

# Nom de l'index Pinecone qui contiendra tes notes de films
PINECONE_INDEX=mes-films

# Garde-fous de coût (facultatif : ces valeurs sont celles par défaut)
# Tours maximum par recherche : chaque tour relit tout le contexte, c'est ce qui coûte.
AGENT_MAX_TURNS=12
# Coût maximum d'une recherche, en dollars
AGENT_MAX_BUDGET_USD=0.25
# Coût maximum par jour, en dollars : au-delà, l'agent refuse de chercher jusqu'au lendemain
AGENT_DAILY_BUDGET_USD=1.00
# Astuce : CLAUDE_MODEL=claude-haiku-5-5 coûte nettement moins cher que Sonnet (choix un peu moins fins).

# Langfuse (facultatif) : suivi et évaluation des recherches. Sans ces clés, rien n'est envoyé.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
